# Copy to .env and fill in. Never commit .env.

# --- GH Archive ---
GHARCHIVE_BASE_URL=https://data.gharchive.org
GHARCHIVE_RAW_DIR=./data/raw

# --- Lakehouse paths (local dev) ---
LAKE_BRONZE=./data/bronze
LAKE_SILVER=./data/silver
LAKE_GOLD=./data/gold

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# --- Postgres (MLflow backend) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=gharchive-churn

# --- Dagster ---
DAGSTER_HOME=./dagster_home
